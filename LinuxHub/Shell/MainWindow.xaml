<Window x:Class="LinuxHub.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:catalog="clr-namespace:LinuxHub.Features.Catalog.Views"
        xmlns:wizard="clr-namespace:LinuxHub.Features.InstallWizard.Views"
        Title="LinuxHub"
        Height="500"
        Width="900"
        Background="#1c1c1c"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <!-- Título -->
        <TextBlock Text="LinuxHub"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Margin="10"/>

        <!-- Abas -->
        <TabControl Margin="10,70,10,10"
                    Background="#202020"
                    Foreground="White"
                    BorderBrush="#333">

            <!-- ABA 1: DISTROS -->
            <TabItem Header="Distros">
                <catalog:CatalogView x:Name="CatalogViewHost"/>
            </TabItem>

            <!-- ABA 2: INSTALAÇÃO -->
            <TabItem Header="Instalation">
                <wizard:InstallWizardView x:Name="InstallWizardViewHost"/>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
