<Window x:Class="LinuxHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinuxHub" Height="500" Width="900" Background="#1c1c1c" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <!-- Título -->
        <TextBlock Text="LinuxHub"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Margin="10"/>

        <!-- Abas -->
        <TabControl Margin="10,70,10,10"
                    Background="#202020"
                    Foreground="White"
                    BorderBrush="#333">

            <!--Aba ! -->
            <TabItem Header="Distribuições">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="10">
                        <!-- Ubuntu -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/ubuntu.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Ubuntu" 
                   Foreground="White" 
                   FontSize="12" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Mint -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/mint.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Mint" 
                                Foreground="White" 
                                FontSize="12" 
                                FontWeight="Bold" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Zorin -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/zorin.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Zorin" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- PopOs -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/popos.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="PopOS" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Fedora -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/fedora.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Fedora" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Kubuntu -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/kubuntu.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Kubuntu" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Xubuntu -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/xubuntu.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Xubuntu" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Manjaro -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/manjaro.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Manjaro" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Arch -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/arch.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Arch" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- EndeavourOS -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/endeavouros.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="EndeavourOS" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Kali Linux -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/kali.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Kali Linux" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- ChromeOS -->
                        <StackPanel Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/chromeos.png" Stretch="Uniform"/>
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="ChromeOS" 
    Foreground="White" 
    FontSize="12" 
    FontWeight="Bold" 
    VerticalAlignment="Center" 
    HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>


            <!-- ABA 2: INSTALAÇÃO -->
            <TabItem Header="Instalação">
                <Grid Background="#222">
                    <TextBlock Text="Painel de Instalação" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            <!-- ABA 3: GUIA / AJUDA -->
            <TabItem Header="Ajuda">
                <Grid Background="#222">
                    <TextBlock Text="Ajuda" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>


        </TabControl>

    </Grid>
</Window>
