<Window x:Class="LinuxHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinuxHub" Height="480" Width="820" Background="#1c1c1c" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <TextBlock Text="LinuxHub" 
                   Foreground="White" 
                   FontSize="32" 
                   FontWeight="Bold"
                   VerticalAlignment="Top"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Escolher uma distribuição Linux" Width="320" Height="45" Margin="0 10"/>
            <Button Content="Instalar sem pendrive" Width="320" Height="45" Margin="0 10"/>
            <Button Content="Guia Linux" Width="320" Height="45" Margin="0 10"/>
        </StackPanel>

    </Grid>
</Window>
