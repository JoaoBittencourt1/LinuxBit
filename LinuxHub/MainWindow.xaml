<Window x:Class="LinuxHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinuxHub"
        Height="500"
        Width="900"
        Background="#1c1c1c"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <!-- Título -->
        <TextBlock Text="LinuxHub"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Margin="10"/>

        <!-- Abas -->
        <TabControl Margin="10,70,10,10"
                    Background="#202020"
                    Foreground="White"
                    BorderBrush="#333">

            <!--Aba
            ! -->
            <TabItem Header="Distros">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="10">
                        <!-- Ubuntu -->
                        <StackPanel x:Name="UbuntuPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/ubuntu.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Ubuntu"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Mint -->
                        <StackPanel x:Name="MintPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/mint.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Mint"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Zorin -->
                        <StackPanel x:Name="ZorinPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/zorin.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Zorin"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- PopOs -->
                        <StackPanel x:Name="PopPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/popos.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="PopOS"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Fedora -->
                        <StackPanel x:Name="FedoraPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/fedora.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Fedora"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Kubuntu -->
                        <StackPanel x:Name="KubuntuPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/kubuntu.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Kubuntu"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Xubuntu -->
                        <StackPanel x:Name="XubuntuPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/xubuntu.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Xubuntu"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Manjaro -->
                        <StackPanel x:Name="ManjaroPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/manjaro.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Manjaro"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Arch -->
                        <StackPanel x:Name="ArchPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/arch.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Arch"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- EndeavourOS -->
                        <StackPanel x:Name="EndeavourosPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/endeavouros.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="EndeavourOS"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Kali Linux -->
                        <StackPanel x:Name="KaliPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/kali.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="Kali Linux"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- ChromeOS -->
                        <StackPanel x:Name="ChromeosPanel"
                                    Width="120"
                                    Height="150"
                                    Margin="10">
                            <Border Width="120"
                                    Height="120"
                                    Background="#333"
                                    CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/chromeos.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <Border Height="20"
                                    Margin="0,5,0,0"
                                    Background="#444"
                                    CornerRadius="4">
                                <TextBlock Text="ChromeOS"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>


                    </WrapPanel>
                </ScrollViewer>
            </TabItem>


            <!-- ABA 2: INSTALAÇÃO -->
            <TabItem Header="Instalation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TÍTULO -->
                        <TextBlock Text="Configuração de Instalação"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,20"/>


                        <GroupBox Header="Imagem ISO e Distribuição"
                                  Grid.Row="1"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Margin="0,0,0,15">

                            <StackPanel Margin="10">

                                <!-- ISO -->
                                <TextBlock Text="Imagem ISO"
                                           Foreground="Gray"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <RadioButton Content="Baixar automaticamente (recomendado)"
                                             Foreground="White"
                                             Margin="0,0,0,6"/>

                                <RadioButton Content="Selecionar ISO manualmente"
                                             Foreground="White"
                                             Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="IsoPathTextBox"
                                             Grid.Column="0"
                                             Height="32"
                                             Background="#333"
                                             Foreground="White"
                                             BorderBrush="#555"
                                             Padding="8"
                                             IsReadOnly="True"
                                             Text="Nenhuma ISO selecionada"/>

                                    <Button Content="Procurar"
                                            Click="BrowseIso_Click"
                                            Grid.Column="1"
                                            Height="32"
                                            Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Separador visual -->
                                <Separator Margin="0,5,0,10"/>

                                <!-- DISTRO -->
                                <TextBlock Text="Distribuição Selecionada"
                                           Foreground="Gray"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal">

                                    <Image x:Name="DistroImage"
                                           Width="40"
                                           Height="40"/>

                                    <TextBlock x:Name="DistroText"
                                               Text="Nenhuma distribuição selecionada"
                                               VerticalAlignment="Center"
                                               Foreground="Gray"
                                               FontSize="14"
                                               Margin="10,0,0,0"/>
                                </StackPanel>

                            </StackPanel>
                        </GroupBox>


                        <!-- TIPO DE INSTALAÇÃO -->
                        <GroupBox Header="Tipo de Instalação"
                                  Grid.Row="3"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Margin="0,0,0,15">

                            <StackPanel Margin="10">

                                <RadioButton x:Name="ReplaceRadio"
                                             Content="Substituir Windows (apagar tudo)"
                                             IsChecked="True"
                                             Checked="InstallTypeChanged"/>

                                <RadioButton x:Name="DualBootRadio"
                                             Content="Instalar em Dual Boot"
                                             Margin="0,6,0,0"
                                             Checked="InstallTypeChanged"/>

                            </StackPanel>
                        </GroupBox>


                        <!-- DISCO (Substituir Windows) -->
                        <GroupBox x:Name="DiskGroup"
                                  Header="Disco de destino"
                                  Grid.Row="4"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Margin="0,0,0,15"
                                  Visibility="Visible">

                            <StackPanel Margin="10">

                                <TextBlock Text="Selecione o disco onde o sistema será instalado"
                                           Foreground="#ccc"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="DiskComboBox"
                                          Height="30"/>

                            </StackPanel>
                        </GroupBox>


                        <!-- PARTIÇÃO (Dual Boot) -->
                        <GroupBox x:Name="PartitionGroup"
                                  Header="Partição para Dual Boot"
                                  Grid.Row="4"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Margin="0,0,0,15"
                                  Visibility="Collapsed">

                            <StackPanel Margin="10">

                                <TextBlock Text="Selecione a partição que será reduzida"
                                           Foreground="#ccc"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="PartitionComboBox"
                                          Height="30"/>

                                <TextBlock Text="Espaço reservado para Linux (GB)"
                                           Foreground="White"
                                           Margin="0,12,0,0"/>

                                <Slider x:Name="LinuxSizeSlider"
                                        Minimum="20"
                                        Maximum="500"
                                        Value="100"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"/>

                                <TextBlock Foreground="#aaa"
                                           HorizontalAlignment="Right"
                                           Text="{Binding ElementName=LinuxSizeSlider,
                                  Path=Value,
                                  StringFormat={}{0} GB}"/>

                            </StackPanel>
                        </GroupBox>



                        <!-- USUÁRIO -->
                        <GroupBox Header="Usuário"
                                  Grid.Row="5"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Margin="0,0,0,15">
                            <StackPanel Margin="10">

                                <Grid Margin="0,0,0,8">
                                    <TextBox x:Name="UserNameBox"
                                             Background="#333"
                                             Foreground="White"
                                             BorderBrush="#555"
                                             Padding="8"
                                             TextChanged="UserNameBox_TextChanged"/>
                                    <TextBlock x:Name="UserNamePlaceholder"
                                               Text="User Name"
                                               Foreground="#888"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <PasswordBox x:Name="PasswordBox"
                                                 Background="#333"
                                                 Foreground="White"
                                                 BorderBrush="#555"
                                                 Padding="8"
                                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                                    <TextBlock x:Name="PasswordPlaceholder"
                                               Text="Password"
                                               Foreground="#888"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <PasswordBox x:Name="ConfirmPasswordBox"
                                                 Background="#333"
                                                 Foreground="White"
                                                 BorderBrush="#555"
                                                 Padding="8"
                                                 PasswordChanged="ConfirmPasswordBox_ConfirmPasswordChanged"/>
                                    <TextBlock x:Name="ConfirmPasswordPlaceholder"
                                               Text="Confirm Password"
                                               Foreground="#888"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <Grid>
                                    <TextBox x:Name="UserPcName"
                                             Background="#333"
                                             Foreground="White"
                                             BorderBrush="#555"
                                             Padding="8"
                                             TextChanged="UserPcName_TextChanged"/>

                                    <TextBlock x:Name="UserPcNamePlaceholder"
                                               Text="Pc Name"
                                               Foreground="#888"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>


                            </StackPanel>
                        </GroupBox>


                        <!-- AVISO + BOTÃO -->
                        <StackPanel Grid.Row="6"
                                    Margin="0,10,0,0">

                            <Border Background="#402020"
                                    BorderBrush="#aa3333"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <TextBlock
                                    Text="⚠ Todos os dados do disco selecionado poderão ser APAGADOS. Faça backup antes de continuar."
                                    Foreground="White"
                                    TextWrapping="Wrap"/>
                            </Border>

                            <Button Content="Instalar Linux"
                                    Height="45"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Background="#2ecc71"
                                    Foreground="Black"
                                    Margin="0,15,0,0"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </TabItem>


        </TabControl>

    </Grid>
</Window>