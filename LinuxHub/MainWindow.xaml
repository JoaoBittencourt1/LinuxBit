<Window x:Class="LinuxHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LinuxHub" Height="500" Width="900" Background="#1c1c1c"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <!-- Título -->
        <TextBlock Text="LinuxHub"
            FontSize="32"
            FontWeight="Bold"
            Foreground="White"
            VerticalAlignment="Top"
            Margin="10" />

        <!-- Abas -->
        <TabControl Margin="10,70,10,10"
            Background="#202020"
            Foreground="White"
            BorderBrush="#333">

            <!--Aba
            ! -->
            <TabItem Header="Distribuições">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="10">
                        <!-- Ubuntu -->
                        <StackPanel x:Name="UbuntuPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/ubuntu.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Ubuntu"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Mint -->
                        <StackPanel x:Name="MintPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/mint.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Mint"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Zorin -->
                        <StackPanel x:Name="ZorinPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/zorin.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Zorin"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- PopOs -->
                        <StackPanel x:Name="PopPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/popos.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="PopOS"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Fedora -->
                        <StackPanel x:Name="FedoraPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/fedora.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Fedora"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Kubuntu -->
                        <StackPanel x:Name="KubuntuPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/kubuntu.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Kubuntu"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Xubuntu -->
                        <StackPanel x:Name="XubuntuPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/xubuntu.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Xubuntu"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Manjaro -->
                        <StackPanel x:Name="ManjaroPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/manjaro.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Manjaro"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Arch -->
                        <StackPanel x:Name="ArchPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/arch.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Arch"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- EndeavourOS -->
                        <StackPanel x:Name="EndeavourosPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/endeavouros.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="EndeavourOS"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Kali Linux -->
                        <StackPanel x:Name="KaliPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/kali.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="Kali Linux"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- ChromeOS -->
                        <StackPanel x:Name="ChromeosPanel" Width="120" Height="150" Margin="10">
                            <Border Width="120" Height="120" Background="#333" CornerRadius="8">
                                <Image Source="pack://application:,,,/Assets/Images/chromeos.png"
                                    Stretch="Uniform" />
                            </Border>
                            <Border Height="20" Margin="0,5,0,0" Background="#444" CornerRadius="4">
                                <TextBlock Text="ChromeOS"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>


                    </WrapPanel>
                </ScrollViewer>
            </TabItem>


            <!-- ABA 2: INSTALAÇÃO -->
            <TabItem Header="Instalação">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- TÍTULO -->
                        <TextBlock Text="Configuração de Instalação"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="0,0,0,20" />

                        <!-- DISTRO -->
                        <GroupBox Header="Distribuição Selecionada"
                            Grid.Row="1"
                            Foreground="White"
                            BorderBrush="#444"
                            Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <Image Width="40"
                                    Height="40"
                                    Source="pack://application:,,,/Assets/Images/ubuntu.png" />
                                <TextBlock Text="Ubuntu 22.04 LTS"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    FontSize="14"
                                    Margin="10,0,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <!-- ISO -->
                        <GroupBox Header="Imagem ISO"
                            Grid.Row="2"
                            Foreground="White"
                            BorderBrush="#444"
                            Margin="0,0,0,15">
                            <StackPanel Margin="10">

                                <RadioButton Content="Baixar automaticamente (recomendado)"
                                    Foreground="White"
                                    Margin="0,0,0,6" />

                                <RadioButton Content="Selecionar ISO manualmente"
                                    Foreground="White"
                                    Margin="0,0,0,6" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="IsoPathTextBox"
                                        Grid.Column="0"
                                        Height="32"
                                        Background="#333"
                                        Foreground="White"
                                        BorderBrush="#555"
                                        Padding="8"
                                        IsReadOnly="True"
                                        Text="Nenhuma ISO selecionada" />


                                    <Button Content="Procurar"
                                        Click="BrowseIso_Click"
                                        Grid.Column="1"
                                        Height="32"
                                        Margin="8,0,0,0" />
                                </Grid>

                            </StackPanel>
                        </GroupBox>

                        <!-- TIPO DE INSTALAÇÃO -->
                        <GroupBox Header="Tipo de Instalação"
                            Grid.Row="3"
                            Foreground="White"
                            BorderBrush="#444"
                            Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <RadioButton Content="Substituir Windows (apagar tudo)"
                                    Foreground="White"
                                    IsChecked="True" />
                                <RadioButton Content="Instalar em Dual Boot"
                                    Foreground="White"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <!-- DISCO -->
                        <GroupBox Header="Disco e Particionamento"
                            Grid.Row="4"
                            Foreground="White"
                            BorderBrush="#444"
                            Margin="0,0,0,15">
                            <StackPanel Margin="10">

                                <TextBlock Text="Disco de destino"
                                    Foreground="White" />

                                <ComboBox x:Name="DiskComboBox"
                                    Margin="0,6,0,12" />


                                <TextBlock Text="Tamanho reservado para Linux"
                                    Foreground="White" />

                                <Slider Minimum="50"
                                    Maximum="500"
                                    Value="200"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True" />

                                <TextBlock Text="200 GB"
                                    Foreground="#aaa"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </GroupBox>

                        <!-- USUÁRIO -->
                        <GroupBox Header="Usuário"
                            Grid.Row="5"
                            Foreground="White"
                            BorderBrush="#444"
                            Margin="0,0,0,15">
                            <StackPanel Margin="10">

                                <Grid Margin="0,0,0,8">
                                    <TextBox x:Name="UserNameBox"
                                        Background="#333"
                                        Foreground="White"
                                        BorderBrush="#555"
                                        Padding="8"
                                        TextChanged="UserNameBox_TextChanged" />
                                    <TextBlock x:Name="UserNamePlaceholder"
                                        Text="Nome de usuário"
                                        Foreground="#888"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                </Grid>

                                <Grid>
                                    <PasswordBox x:Name="PasswordBox"
                                        Background="#333"
                                        BorderBrush="#555"
                                        Padding="8"
                                        PasswordChanged="PasswordBox_PasswordChanged" />
                                    <TextBlock x:Name="PasswordPlaceholder"
                                        Text="Senha"
                                        Foreground="#888"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                </Grid>

                            </StackPanel>
                        </GroupBox>


                        <!-- AVISO + BOTÃO -->
                        <StackPanel Grid.Row="6" Margin="0,10,0,0">

                            <Border Background="#402020"
                                BorderBrush="#aa3333"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                                <TextBlock
                                    Text="⚠ Todos os dados do disco selecionado poderão ser APAGADOS. Faça backup antes de continuar."
                                    Foreground="White"
                                    TextWrapping="Wrap" />
                            </Border>

                            <Button Content="Instalar Linux"
                                Height="45"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="#2ecc71"
                                Foreground="Black"
                                Margin="0,15,0,0" />
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </TabItem>


        </TabControl>

    </Grid>
</Window>