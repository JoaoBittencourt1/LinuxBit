<UserControl x:Class="LinuxHub.Features.InstallWizard.Views.InstallWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:conv="clr-namespace:LinuxHub.Features.InstallWizard.Views.Converters"
             xmlns:models="clr-namespace:LinuxHub.Common.Models">

    <UserControl.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:EnumMatchConverter x:Key="EnumMatch"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <TextBlock Text="installation configuration"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <GroupBox Header="Iso Image and Distro"
                      Grid.Row="1"
                      Foreground="White"
                      BorderBrush="#444"
                      Margin="0,0,0,15">

                <StackPanel Margin="10">

                    <TextBlock Text="Iso Image"
                               Foreground="Gray"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Download here(It may be slower than downloading from the source)"
                                     Foreground="White"
                                     IsChecked="{Binding Iso.IsManualSelect, Converter={StaticResource InverseBool}}"
                                     Margin="0,0,20,0"/>
                        <RadioButton Content="Select ISO manually"
                                     Foreground="White"
                                     IsChecked="{Binding Iso.IsManualSelect}"/>
                    </StackPanel>

                    <!-- ISO manual -->
                    <Grid Margin="0,0,0,15"
                          Visibility="{Binding Iso.IsManualIsoVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Height="32"
                                 Background="#333"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 Padding="8"
                                 IsReadOnly="True"
                                 Text="{Binding Iso.ManualIsoPath, TargetNullValue='No ISO selected', Mode=OneWay}"/>

                        <Button Content="Search"
                                Click="BrowseIso_Click"
                                Grid.Column="1"
                                Height="32"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Bloco da Distribuição Selecionada -->
                    <StackPanel Visibility="{Binding Iso.IsDistroSelectionVisible, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Selected Distribution"
                                   Foreground="Gray"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <ComboBox Width="200"
                                      ItemsSource="{Binding Iso.Distros}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding Iso.SelectedDistro}"/>

                            <Button Content="Download ISO"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    Command="{Binding Iso.DownloadIsoCommand}"
                                    Visibility="{Binding Iso.IsDownloadButtonVisible, Converter={StaticResource BoolToVis}}"/>

                            <Button Content="Cancel Download"
                                    Command="{Binding Iso.CancelDownloadCommand}"
                                    Visibility="{Binding Iso.IsDownloading, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Barra de progresso -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <ProgressBar Height="20"
                                     Width="250"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Iso.DownloadPercent, Mode=OneWay}"
                                     Visibility="{Binding Iso.IsDownloading, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Foreground="White"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Iso.DownloadStatusText, Mode=OneWay}"
                                   Visibility="{Binding Iso.IsDownloading, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Imagem e texto da distro -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0"
                                Visibility="{Binding Iso.IsDistroDisplayVisible, Converter={StaticResource BoolToVis}}">
                        <Image Width="40" Height="40" Source="{Binding Iso.DisplayedDistro.ImagePath}"/>
                        <TextBlock Text="{Binding Iso.DisplayedDistro.Name, TargetNullValue='Nenhuma distribuição selecionada'}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontSize="14"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            <!-- TIPO DE INSTALAÇÃO -->
            <GroupBox Header="Installation Type"
                      Grid.Row="3"
                      Foreground="White"
                      BorderBrush="#444"
                      Margin="0,0,0,15">

                <StackPanel Margin="10">
                    <RadioButton Content="Replace Windows (erase everything)"
                                 Foreground="White"
                                 IsChecked="{Binding Target.Mode, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:InstallMode.Replace}}"/>

                    <RadioButton Content="Install in Dual Boot"
                                 Margin="0,6,0,0"
                                 Foreground="White"
                                 IsChecked="{Binding Target.Mode, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:InstallMode.DualBoot}}"/>
                </StackPanel>
            </GroupBox>

            <!-- DISCO (Substituir Windows) -->
            <GroupBox Header="Target disk"
                      Grid.Row="4"
                      Foreground="White"
                      BorderBrush="#444"
                      Margin="0,0,0,15"
                      Visibility="{Binding Target.IsReplaceMode, Converter={StaticResource BoolToVis}}">

                <StackPanel Margin="10">
                    <TextBlock Text="Select the disk where the system will be installed."
                               Foreground="#ccc"
                               Margin="0,0,0,6"/>

                    <ComboBox Height="30"
                              ItemsSource="{Binding Target.Disks}"
                              SelectedItem="{Binding Target.SelectedDisk}"/>
                </StackPanel>
            </GroupBox>

            <!-- PARTIÇÃO (Dual Boot) -->
            <GroupBox Header="Dual Boot Partition"
                      Grid.Row="4"
                      Foreground="White"
                      BorderBrush="#444"
                      Margin="0,0,0,15"
                      Visibility="{Binding Target.IsDualBootMode, Converter={StaticResource BoolToVis}}">

                <StackPanel Margin="10">
                    <TextBlock Text="Select the partition to be shrunk."
                               Foreground="#ccc"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="PartitionComboBox"
                              Height="30"
                              ItemsSource="{Binding Target.Partitions}"
                              SelectedItem="{Binding Target.SelectedPartition}"/>

                    <TextBlock Text="Space reserved for Linux (GB)"
                               Foreground="White"
                               Margin="0,12,0,0"/>

                    <Slider x:Name="LinuxSizeSlider"
                            Minimum="{Binding Target.SliderMinimum}"
                            Maximum="{Binding Target.SliderMaximum}"
                            Value="{Binding Target.LinuxPartitionSizeGb}"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"/>

                    <TextBlock Foreground="#aaa"
                               HorizontalAlignment="Right"
                               Text="{Binding ElementName=LinuxSizeSlider, Path=Value, StringFormat={}{0} GB}"/>
                </StackPanel>
            </GroupBox>

            <!-- USUÁRIO -->
            <GroupBox Header="Usuário"
                      Grid.Row="5"
                      Foreground="White"
                      BorderBrush="#444"
                      Margin="0,0,0,15">
                <StackPanel Margin="10">

                    <Grid Margin="0,0,0,8">
                        <TextBox Background="#333"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 Padding="8"
                                 Text="{Binding Account.Username, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="User Name"
                                   Foreground="#888"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Account.Username, Converter={StaticResource EmptyToVis}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="PasswordBox"
                                     Background="#333"
                                     Foreground="White"
                                     BorderBrush="#555"
                                     Padding="8"
                                     Visibility="{Binding Account.IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBox Background="#333"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 Padding="8"
                                 Visibility="{Binding Account.IsPasswordVisible, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Account.Password, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Password"
                                   Foreground="#888"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Account.Password, Converter={StaticResource EmptyToVis}}"/>

                        <Button Content="👁"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                Foreground="White"
                                Command="{Binding Account.TogglePasswordVisibilityCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Background="#333"
                                     Foreground="White"
                                     BorderBrush="#555"
                                     Padding="8"
                                     Visibility="{Binding Account.IsConfirmPasswordVisible, Converter={StaticResource InverseBoolToVis}}"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                        <TextBox Background="#333"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 Padding="8"
                                 Visibility="{Binding Account.IsConfirmPasswordVisible, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Account.ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Confirm Password"
                                   Foreground="#888"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Account.ConfirmPassword, Converter={StaticResource EmptyToVis}}"/>

                        <Button Content="👁"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                Foreground="White"
                                Command="{Binding Account.ToggleConfirmPasswordVisibilityCommand}"/>
                    </Grid>

                    <TextBlock Text="As senhas não coincidem"
                               Foreground="#FF5C5C"
                               FontSize="12"
                               Margin="0,0,0,8"
                               Visibility="{Binding Account.PasswordsMismatch, Converter={StaticResource BoolToVis}}"/>

                    <Grid>
                        <TextBox Background="#333"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 Padding="8"
                                 Text="{Binding Account.Hostname, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Pc Name"
                                   Foreground="#888"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Account.Hostname, Converter={StaticResource EmptyToVis}}"/>
                    </Grid>

                </StackPanel>
            </GroupBox>

            <!-- AVISO + BOTÃO -->
            <StackPanel Grid.Row="6" Margin="0,10,0,0">
                <Border Background="#402020"
                        BorderBrush="#aa3333"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <TextBlock Text=" All data on the selected disk may be DELETED. Back up your data before continuing. "
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </Border>

                <Button Content="Install Linux"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#2ecc71"
                        Foreground="Black"
                        Margin="0,15,0,0"
                        Command="{Binding InstallCommand}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
