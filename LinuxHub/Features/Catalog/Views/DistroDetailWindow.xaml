<Window x:Class="LinuxHub.Features.Catalog.Views.DistroDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distribuição" Height="650" Width="850" Background="#1c1c1c" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Botão de voltar -->
        <Button x:Name="BackButton"
        Content="← Voltar"
        Width="90"
        Height="34"
        Padding="6,2"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="0,0,0,10"
        Command="{Binding BackCommand}"
        Background="white"
        BorderBrush="White"
        Cursor="Hand"
        Panel.ZIndex="10"/>

        <!-- Imagem da distro -->
        <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Margin="10">
            <Image x:Name="DistroImage" Source="{Binding ImagePath}" Stretch="Uniform"/>
        </Border>

        <!-- Painel de informações -->
        <StackPanel Grid.Column="1" Margin="20,10" VerticalAlignment="Top">
            <!-- Nome -->
            <TextBlock Text="{Binding Name}"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Descrição -->
            <TextBlock Text="{Binding Description}"
                       Foreground="White"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       Margin="0,0,0,20"/>

            <!-- Carrossel -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <!-- Botão de voltar -->
                <Button Content="◀" Width="30" Height="30"
                        Grid.Column="0"
                        Command="{Binding PrevCommand}"/>

                <!-- Área do carrossel -->
                <ContentControl x:Name="CarouselContent"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="340"
                    Height="300"/>

                <!-- Botão de avançar -->
                <Button Content="▶" Width="30" Height="30"
                        Grid.Column="2"
                        Command="{Binding NextCommand}"/>
            </Grid>

            <!-- Seção de download -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Download: "
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding DownloadLinkText}"
                           Foreground="LightBlue"
                           FontSize="16"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           MouseLeftButtonUp="DistroDownload_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
