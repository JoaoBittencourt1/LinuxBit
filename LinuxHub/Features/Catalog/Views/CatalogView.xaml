<UserControl x:Class="LinuxHub.Features.Catalog.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Distros}" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="120"
                                Height="150"
                                Margin="10"
                                Cursor="Hand"
                                MouseLeftButtonUp="DistroTile_MouseLeftButtonUp">
                        <Border Width="120"
                                Height="120"
                                Background="#333"
                                CornerRadius="8">
                            <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                        </Border>
                        <Border Height="20"
                                Margin="0,5,0,0"
                                Background="#444"
                                CornerRadius="4">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
