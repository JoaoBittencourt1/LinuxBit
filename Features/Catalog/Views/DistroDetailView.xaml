<UserControl x:Class="LinuxHub.Features.Catalog.Views.DistroDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:LinuxHub.Common.Localization">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Botão de voltar -->
        <ui:Button Content="{loc:Loc CatalogDetail_Back}"
                   Command="{Binding BackCommand}"
                   Icon="{ui:SymbolIcon ArrowLeft24}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Panel.ZIndex="10"
                   Margin="0,0,0,10"/>

        <!-- Imagem da distro -->
        <ui:Card Grid.Column="0" Margin="0,50,10,0">
            <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
        </ui:Card>

        <!-- Painel de informações -->
        <StackPanel Grid.Column="1" Margin="20,50,0,0" VerticalAlignment="Top">
            <TextBlock Text="{Binding Name}"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding Description}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,20"/>

            <!-- Carrossel -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Width="32"
                           Height="32"
                           Icon="{ui:SymbolIcon ChevronLeft24}"
                           Command="{Binding PrevCommand}"/>

                <ContentControl x:Name="CarouselContent"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="340"
                                Height="300"/>

                <ui:Button Grid.Column="2"
                           Width="32"
                           Height="32"
                           Icon="{ui:SymbolIcon ChevronRight24}"
                           Command="{Binding NextCommand}"/>
            </Grid>

            <!-- Download -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc CatalogDetail_DownloadLabel}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ui:HyperlinkButton Content="{loc:Loc CatalogDetail_DownloadLinkText}"
                                     Command="{Binding OpenDownloadLinkCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
